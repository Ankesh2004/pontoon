# ============================================================
# Pontoon - 100% Self-Hosted Configuration
# ============================================================
# All data services (Postgres, Redis) run inside docker-compose.
# Only secrets/identities need to be set here.
# Copy to .env and fill in: cp .env.example .env

# ---- GitHub OAuth (required) ----
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ---- JWT (required) ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string

# ---- Domain (required) ----
# Subdomain pattern: <project>.<DEFAULT_DOMAIN>
DEFAULT_DOMAIN=pontoon.example.com

# ---- Self-Hosted PostgreSQL ----
# These match the postgres service in docker-compose.yml.
# Override only if you change the credentials.
POSTGRES_USER=pontoon
POSTGRES_PASSWORD=pontoon
POSTGRES_DB=pontoon

# ---- API Server ----
API_ADDR=:8080

# ---- Frontend URL (required for OAuth redirect) ----
# Where the frontend is running (used for OAuth callback redirect)
FRONTEND_URL=http://localhost:5173

# ---- CORS ----
# Allowed origins for cross-origin requests (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Worker / Capacity ----
# No longer memory-starved; tuned for capable servers.
MAX_CONTAINER_MEMORY_MB=256
TOTAL_CONTAINER_MEMORY_MB=2048

# ---- Webhooks (global fallback, per-project secrets preferred) ----
GITHUB_WEBHOOK_SECRET=

# ---- TLS (Traefik Let's Encrypt) ----
ACME_EMAIL=admin@example.com

# ---- Cloudflare Tunnel (optional; enable with --profile tunnel) ----
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# ---- For local (non-Docker) development only ----
# When running `go run cmd/api` directly on host, point at exposed ports:
# DATABASE_URL=postgres://pontoon:pontoon@localhost:5432/pontoon?sslmode=disable
# REDIS_URL=redis://localhost:6379/0